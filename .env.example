# Copy to .env and fill in. Never commit .env.

# live | fixture | replay  (tests and CI always use fixture)
DATA_MODE=fixture

# Database (docker-compose service "db")
POSTGRES_USER=emissions
POSTGRES_PASSWORD=emissions
POSTGRES_DB=emissions
DATABASE_URL=postgresql+psycopg://emissions:emissions@db:5432/emissions

# Token for admin endpoints (header X-Admin-Token). Empty = admin endpoints refuse every request.
ADMIN_TOKEN=

# Tests marked `live` run only when RUN_LIVE=1
RUN_LIVE=0

# Earth Engine service account (Phase 0)
EE_PROJECT=
EE_SERVICE_ACCOUNT=
EE_KEY_FILE=secrets/ee-key.json

# Copernicus Climate Data Store (ERA5 100 m winds); or use ~/.cdsapirc
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=

# NASA FIRMS MAP_KEY
FIRMS_MAP_KEY=

# Earth Observation Group (VIIRS Nightfire). Optional: leave blank unless you hold a licence and a
# paid scripted-access subscription. Nothing fails when these are empty.
EOG_CLIENT_ID=
EOG_CLIENT_SECRET=

# SMTP (MailHog in dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Optional overrides of the config files
CONFIG_PATH=config/settings.yaml
WORDING_PATH=config/wording.yaml
