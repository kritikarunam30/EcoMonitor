# Secrets (only .env.example is committed)
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
*.pem
*-key.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Data and models (keep placeholders and samples)
data/cache/*
!data/cache/.gitkeep
data/registry/raw/*
!data/registry/raw/.gitkeep
# Hand-downloaded source files (CEA reports, licence-gated Nightfire files)
data/raw/
data/demo/
data/user_dump.json
models/*
!models/.gitkeep
!models/*stub*

# Web
web/node_modules/
web/dist/
*.tsbuildinfo

# Logs and temp files
*.log
npm-debug.log*
*.tmp
*.swp

# Editors / OS
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
